# Aplicación
APP_PORT=5173
API_PORT=3000
APP_ORIGIN=http://localhost:5173

# PostgreSQL local (valores de desarrollo, no usar en producción)
POSTGRES_DB=dealgine
POSTGRES_USER=dealgine
POSTGRES_PASSWORD=dealgine
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dealgine:dealgine@postgres:5432/dealgine

# Mailpit local
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Correo de producción (Mailpit los reemplaza dentro del Compose de desarrollo)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dealgine <no-reply@example.com>
SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# Producción: sustituir DATABASE_URL por la URL suministrada por el gestor
# de secretos o proveedor de base de datos. No guardar credenciales reales aquí.
# DATABASE_URL=postgresql://usuario:contrasena@db.example.com:5432/dealgine
